+-  if (val >= 1e9) return `${(val / 1e9).toFixed(1)} T├ƒΓòùΓòû VND`;
+-  if (val >= 1e6) return `${(val / 1e6).toFixed(0)} Tr VND`;
+-  return `${Math.round(val).toLocaleString("vi-VN")} VND`;
+-};
