+-        e.preventDefault();
+-        setShowShortcutsModal((prev) => !prev);
+-      } else if (!isInput && (e.key === "d" || e.key === "D")) {
+-        toggleTheme();
+-      } else if (!isInput && (e.key === "p" || e.key === "P") && !e.ctrlKey && !e.metaKey) {
+-        handleExportPDF();
